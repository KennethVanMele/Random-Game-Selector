<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:UI.Avalonia"
        x:Class="UI.Avalonia.RemoveGames"
        Width="520" Height="569"
        WindowStartupLocation="CenterScreen"
        Opened="Window_Opened"
        Title="Remove Games">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Remove" Click="BtnRemove_Click" />
            <Button Content="Cancel" Click="BtnCancel_Click" />
        </StackPanel>

        <Grid RowDefinitions="Auto,*">
            <Grid Grid.Row="0" ColumnDefinitions="40,*,160" Margin="4,0,4,4">
                <TextBlock Grid.Column="1" Text="Title" FontWeight="SemiBold" />
                <TextBlock Grid.Column="2" Text="Platform" FontWeight="SemiBold" />
            </Grid>
            <ListBox x:Name="lbGames" Grid.Row="1">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="local:GameRow">
                        <Grid ColumnDefinitions="40,*,160">
                            <CheckBox Grid.Column="0" IsChecked="{Binding Remove, Mode=TwoWay}" />
                            <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{Binding Platform}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </DockPanel>
</Window>
